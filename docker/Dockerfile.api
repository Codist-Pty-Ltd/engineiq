# syntax=docker/dockerfile:1
# Default bases use AWS ECR Public (official .NET mirror). Override if MCR works: mcr.microsoft.com/dotnet/sdk:8.0
ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0
ARG DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:8.0

FROM ${DOTNET_SDK_IMAGE} AS build
WORKDIR /src
COPY src/ ./src/
RUN dotnet publish src/EngineIQ.API/EngineIQ.API.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM ${DOTNET_ASPNET_IMAGE} AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:5000
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:5000/health || exit 1
ENTRYPOINT ["dotnet", "EngineIQ.API.dll"]
