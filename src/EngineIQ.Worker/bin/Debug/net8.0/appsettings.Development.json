{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Trust": {
    "PublicApiBaseUrl": "http://localhost:5056",
    "DataLocation": "Hetzner SA / Johannesburg",
    "DpaPdfUrl": "https://engineiq.co.za/legal/dpa.pdf",
    "AiProvider": "Anthropic"
  },
  "GitHub": {
    "AppId": 0,
    "PrivateKeyPem": "",
    "WebhookSecret": ""
  },
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-sonnet-4-6",
    "UsdToZar": 18.5,
    "InputUsdPerMillionTokens": 3,
    "OutputUsdPerMillionTokens": 15
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Username=engineiq;Password=engineiq;Database=engineiq"
  },
  "RabbitMq": {
    "ConnectionString": "amqp://guest:guest@localhost:5672/",
    "QueueName": "pr-review-jobs",
    "DeadLetterQueueName": "pr-review-jobs-dlq",
    "JiraQueueName": "jira-issue-jobs",
    "JiraDeadLetterQueueName": "jira-issue-jobs-dlq",
    "IndexQueueName": "repo-index-jobs",
    "IndexDeadLetterQueueName": "repo-index-jobs-dlq",
    "BackfillQueueName": "jira-backfill-jobs",
    "BackfillDeadLetterQueueName": "jira-backfill-jobs-dlq"
  },
  "Jira": {
    "TimeoutSeconds": 15,
    "TriggerLabel": "engineiq",
    "MaxBackfillIssues": 100,
    "BackfillDelayMs": 2000,
    "BackfillTimeoutMinutes": 30
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "ContextCacheTtlHours": 24
  },
  "Voyage": {
    "ApiKey": "",
    "Model": "voyage-code-3",
    "Dimensions": 1024,
    "BatchSize": 96,
    "MaxInputChars": 24000
  },
  "Indexing": {
    "MaxFileSizeKb": 200,
    "EmbedBatchSize": 96,
    "JobTimeoutMinutes": 10,
    "SkipPathSegments": ["node_modules", "bin", "obj", "dist", ".git", "packages", "vendor", ".angular"]
  },
  "Retrieval": {
    "VectorTopK": 30,
    "TextTopK": 30,
    "MaxHits": 16,
    "MaxHitsPerFile": 3,
    "MaxContextChars": 30000
  },
  "Observability": {
    "Enabled": true,
    "MetricsPort": 9465
  }
}
